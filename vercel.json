{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "cs.descompliqueiofc.com" }],
      "destination": "/index-cs.html"
    },
    { "source": "/(.*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
